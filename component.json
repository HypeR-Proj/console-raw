{
  "SPDX-FileCopyrightText": "2026 roolrz",
  "SPDX-License-Identifier": "Apache-2.0",
  "version": 1,
  "name": "console-raw",
  "kind": "service",
  "origin": {
    "repository": "https://github.com/roolrz/HypeR",
    "commit": "8d42d047058a2b58a291803700e86487fb723f7a"
  },
  "packages": [
    "hyper-console-raw-system"
  ],
  "tests": [
    [
      "make",
      "app-test",
      "APP_TEST_PACKAGE=hyper-console-raw-system"
    ]
  ],
  "cargo": [
    {
      "manifest": "Cargo.toml",
      "domain": "system"
    }
  ],
  "artifacts": [
    {
      "binary": "hyper-console-raw-system",
      "staged": "console-raw-system",
      "destination": "svc/console-raw",
      "mode": "0755",
      "profiles": [
        "development"
      ],
      "rust_runtime": "std",
      "environment": "system",
      "manifest": "Cargo.toml",
      "enabled": true,
      "requires": [
        {
          "module": "component-manager",
          "artifact": "component-manager"
        }
      ]
    }
  ],
  "build": {
    "requires": [
      "toolchain"
    ],
    "actions": {
      "all": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ],
      "build": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ],
      "check": [
        [
          "python3",
          "{workspace}/scripts/build-native-module.py",
          "--module",
          "{module}",
          "--action",
          "{action}"
        ]
      ]
    }
  }
}
